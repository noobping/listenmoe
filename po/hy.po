msgid "Play %s"
msgstr "Նվագարկել %s"

msgid "About"
msgstr "Ծրագրի մասին"

msgid "Connecting..."
msgstr "Միացում..."

msgid "Main Menu"
msgstr "Գլխավոր ընտրացանկ"

msgid "Quit"
msgstr "Ելք"

msgid "Keyboard Shortcuts"
msgstr "Ստեղնաշարի դյուրանցումներ"

msgid "General"
msgstr "Ընդհանուր"

msgid "Playback"
msgstr "Նվագարկում"

msgid "Volume"
msgstr "Ձայնի ուժգնություն"

msgid "Play or pause"
msgstr "Նվագարկել կամ դադարեցնել"

msgid "Stop playback"
msgstr "Կանգնեցնել նվագարկումը"

msgid "Copy current track"
msgstr "Պատճենել ընթացիկ երգը"

msgid "Stations"
msgstr "Կայաններ"

msgid "Play J-POP"
msgstr "Նվագարկել J-POP"

msgid "Play K-POP"
msgstr "Նվագարկել K-POP"

msgid "Previous station"
msgstr "Նախորդ կայանը"

msgid "Next station"
msgstr "Հաջորդ կայանը"

msgid "Window"
msgstr "Պատուհան"

msgid "Open preferences"
msgstr "Բացել նախապատվությունները"

msgid "Show shortcuts"
msgstr "Ցույց տալ դյուրանցումները"

msgid "Preferences"
msgstr "Նախապատվություններ"

msgid "Startup Defaults"
msgstr "Գործարկման լռելյայն կարգավորումներ"

msgid "Experimental Features"
msgstr "Փորձնական գործառույթներ"

msgid "Default station"
msgstr "Լռելյայն կայան"

msgid "J-POP"
msgstr "J-POP"

msgid "K-POP"
msgstr "K-POP"

msgid "Autoplay"
msgstr "Ինքնաշխատ նվագարկում"

msgid "Start playing automatically on launch"
msgstr "Գործարկելիս ինքնաշխատ սկսել նվագարկումը"

msgid "Enable pause and resume"
msgstr "Միացնել դադարեցումն ու վերսկսումը"

msgid "Use pause and resume for the main playback button"
msgstr "Հիմնական նվագարկման կոճակի համար օգտագործել դադարեցումն ու վերսկսումը"

msgid "Discord Rich Presence"
msgstr "Discord Rich Presence"

msgid "Enable Discord Rich Presence at runtime"
msgstr "Աշխատանքի ընթացքում միացնել Discord Rich Presence-ը"

msgid "It is time to ditch other radios. Stream and metadata provided by LISTEN.moe."
msgstr "Ժամանակն է հրաժարվել այլ ռադիոկայաններից: Հեռարձակումը և մետատվյալները տրամադրվում են LISTEN.moe-ի կողմից:"

msgid "J-POP and K-POP radio"
msgstr "J-POP և K-POP ռադիո"

msgid "Listen to J-POP and K-POP"
msgstr "Լսեք J-POP և K-POP"

msgid "Pause and resume the live stream"
msgstr "Դադարեցնել և վերսկսել ուղիղ հեռարձակումը"

msgid "Animated sound bars that react to the music"
msgstr "Անիմացիոն ձայնային շերտեր, որոնք արձագանքում են երաժշտությանը"

msgid "Dynamic colors based on the current album or artist cover"
msgstr "Փոփոխվող գույներ՝ ըստ ընթացիկ ալբոմի շապիկի կամ կատարողի պատկերի"

msgid "No ads"
msgstr "Ոչ մի գովազդ"

msgid "Initial release."
msgstr "Նախնական թողարկում."

msgid "When connected and there is no album or artist image"
msgstr "Երբ կապը հաստատված է, բայց ալբոմի կամ կատարողի պատկեր չկա"

msgid "Colored window when connected"
msgstr "Գունավոր պատուհան, երբ միացված է"

msgid "AI translation (GPT-5.2); reviewed by nobody"
msgstr "Machine translation (Google Translate, edited with Codex); not human-reviewed"

msgid "This release focuses on visuals and localization."
msgstr "Այս թողարկումը կենտրոնանում է վիզուալների և տեղայնացման վրա:"

msgid "Fine-tuned dark/light mode detection so light colors are no longer mistaken for dark ones."
msgstr "Մուգ/թեթև ռեժիմի հստակ կարգավորում, այնպես որ բաց գույներն այլևս չեն շփոթվում մուգ գույների հետ:"

msgid "Polished translations and improved how they are applied."
msgstr "Հղկված թարգմանություններ և կատարելագործված դրանց կիրառման եղանակը:"

msgid "Removed gaps between sound bars."
msgstr "Ձայնային գծերի միջև բացերը հեռացվեցին:"

msgid "Streaming logic now better handles connection issues and stream changes."
msgstr "Հոսքային տրամաբանությունն այժմ ավելի լավ է լուծում կապի խնդիրները և հոսքի փոփոխությունները:"

msgid "Clarified the application description."
msgstr "Պարզեց դիմումի նկարագրությունը:"

msgid "Translated image captions"
msgstr "Թարգմանված պատկերների ենթագրեր"

msgid "Updated screenshots to use a more reasonable window size"
msgstr "Թարմացված սքրինշոթներ՝ պատուհանի ավելի ողջամիտ չափս օգտագործելու համար"

msgid "Updated application icon"
msgstr "Թարմացված հավելվածի պատկերակը"

msgid "Display the application icon in media controls."
msgstr "Ցուցադրել հավելվածի պատկերակը մեդիա կառավարում:"

msgid "Optional Discord activity sharing"
msgstr "Կամընտիր Discord գործունեության փոխանակում"

msgid "Added Discord activity sharing."
msgstr "Ավելացվեց Discord-ի գործունեության համօգտագործումը:"

msgid "Reconnect to Discord instead of disabling this feature."
msgstr "Այս գործառույթն անջատելու փոխարեն նորից միացեք Discord-ին:"

msgid "Added flags to control pause behavior, autoplay, or disable Discord integration."
msgstr "Ավելացվել են դրոշներ՝ վերահսկելու դադարի վարքը, ավտոմատ նվագարկումը կամ անջատելու Discord ինտեգրումը:"

msgid "Fixed an issue where paused playback resumed during a network disruption."
msgstr "Շտկվել է խնդիրը, երբ դադարեցված նվագարկումը վերսկսվել է ցանցի խափանման ժամանակ:"

msgid "Added preferences and keyboard shortcuts."
msgstr "Ավելացվել են նախապատվություններ և ստեղնաշարի դյուրանցումներ:"

msgid "Changed pause, resume, and station switching behavior."
msgstr "Փոփոխվել է դադարի, վերսկսման և կայանի միացման վարքագիծը:"

msgid "Added startup options for pause/resume or stop behavior, with play/stop now the default."
msgstr "Ավելացվեց գործարկման ընտրանքներ դադարի/վերսկսման կամ դադարեցման վարքագծի համար, իսկ հիմա նվագարկումը/դադարեցումը լռելյայն է:"

msgid "Check for updates"
msgstr "Ստուգել թարմացումները"

msgid "Cancel update"
msgstr "Չեղարկել թարմացումը"

msgid "Couldn't check for updates"
msgstr "Չհաջողվեց ստուգել թարմացումների առկայությունը"

msgid "Try again later."
msgstr "Փորձեք ավելի ուշ:"

msgid "Already up to date"
msgstr "Արդեն արդիական"

msgid "You have the latest version of Listen Moe."
msgstr "Դուք ունեք Listen Moe-ի վերջին տարբերակը:"

msgid "The release metadata is missing a valid SHA-256 digest."
msgstr "Թողարկման մետատվյալներում բացակայում է վավեր SHA-256 հեշը։"

msgid "Couldn't download the update"
msgstr "Չհաջողվեց ներբեռնել թարմացումը"

msgid "Update canceled"
msgstr "Թարմացումը չեղարկվել է"

msgid "The update was canceled."
msgstr "Թարմացումը չեղարկվել է:"

msgid "The update check was canceled."
msgstr "Թարմացման ստուգումը չեղարկվել է:"

msgid "The downloaded installer will not be installed."
msgstr "Ներբեռնված տեղադրիչը չի տեղադրվի:"

msgid "Installing update"
msgstr "Թարմացման տեղադրում"

msgid "Listen Moe will close."
msgstr "Listen Moe-ն կփակվի։"

msgid "Couldn't install the update"
msgstr "Չհաջողվեց տեղադրել թարմացումը"

msgid "Checking for updates"
msgstr "Թարմացումների ստուգում"

msgid "Downloading update"
msgstr "Թարմացումը ներբեռնվում է"

msgid "Update ready"
msgstr "Թարմացումը պատրաստ է"

msgid "Version"
msgstr "Տարբերակ"

msgid "Downloaded"
msgstr "Ներբեռնված"

msgid "Looking for a newer Windows installer on GitHub Releases."
msgstr "GitHub Releases-ում որոնվում է ավելի նոր տեղադրիչ Windows-ի համար։"

msgid "A newer Windows release is available."
msgstr "Հասանելի է ծրագրի ավելի նոր տարբերակ Windows-ի համար։"

msgid "The installer is ready to run."
msgstr "Տեղադրիչը պատրաստ է գործարկման:"

msgid "Couldn't start the installer."
msgstr "Չհաջողվեց գործարկել տեղադրիչը:"

msgid "Removed pause/resume from stable builds."
msgstr "Կայուն տարբերակներից հեռացվել է դադարեցման և վերսկսման հնարավորությունը։"

msgid "Separate experimental features from stable features."
msgstr "Փորձնական գործառույթներն առանձնացվել են կայուն գործառույթներից։"

msgid "Volume control added."
msgstr "Ավելացվեց ձայնի վերահսկում:"

msgid "Karaoke"
msgstr "Կարաոկե"

msgid "Show karaoke"
msgstr "Ցույց տալ կարաոկե"

msgid "Finding lyrics…"
msgstr "Երգի բառերի որոնում…"

msgid "Just a moment"
msgstr "Ընդամենը մի պահ"

msgid "No synchronized lyrics"
msgstr "Համաժամեցված երգի բառեր չկան"

msgid "This song can still be your tiny concert."
msgstr "Այս երգը դեռ կարող է լինել ձեր փոքրիկ համերգը:"

msgid "Couldn't load lyrics"
msgstr "Չհաջողվեց բեռնել երգի բառերը"

msgid "Try again in a moment."
msgstr "Մի պահ նորից փորձեք:"

msgid "Lyrics by LRCLIB"
msgstr "Երգի բառերը տրամադրում է LRCLIB-ը"

msgid "Added lyrics."
msgstr "Ավելացվել են երգի բառերը։"

msgid "Added a song progress bar."
msgstr "Ավելացվեց երգի առաջընթացի գոտի:"

msgid "Long artist and song names scroll smoothly."
msgstr "Կատարողների և երգերի երկար անունները սահուն շարժվում են։"

msgid "Hover over the title to see the full text."
msgstr "Ամբողջ տեքստը տեսնելու համար ցուցիչը պահեք վերնագրի վրա։"

msgid "Scrolling text and background animations respect Reduce Motion."
msgstr "Շարժվող տեքստը և ֆոնային անիմացիաները հաշվի են առնում շարժումը նվազեցնելու կարգավորումը։"

msgid "Translate"
msgstr "Թարգմանել"

msgid "Help translate Listen Moe"
msgstr "Օգնեք թարգմանել Listen Moe-ը"

msgid "Help improve Listen Moe translations on Weblate."
msgstr "Օգնեք բարելավել Listen Moe-ի թարգմանությունները Weblate-ում։"

msgid "Open Weblate"
msgstr "Բացել Weblate-ը"
