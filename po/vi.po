msgstr "Tự động phát khi khởi động"

msgid "Enable pause and resume"
msgstr "Bật tạm dừng và tiếp tục"

msgid "Use pause and resume for the main playback button"
msgstr "Dùng tạm dừng và tiếp tục cho nút phát chính"

msgid "Discord Rich Presence"
msgstr "Discord Rich Presence"

msgid "Enable Discord Rich Presence at runtime"
msgstr "Bật Discord Rich Presence khi ứng dụng đang chạy"

msgid "It is time to ditch other radios. Stream and metadata provided by LISTEN.moe."
msgstr "Đã đến lúc bỏ các đài khác. Luồng và siêu dữ liệu được cung cấp bởi LISTEN.moe."

msgid "J-POP and K-POP radio"
msgstr "Đài phát thanh J-POP và K-POP"

msgid "Listen to J-POP and K-POP"
msgstr "Nghe J-POP và K-POP"

msgid "Pause and resume the live stream"
msgstr "Tạm dừng và tiếp tục phát trực tiếp"

msgid "Animated sound bars that react to the music"
msgstr "Các cột âm thanh chuyển động theo nhạc"

msgid "Dynamic colors based on the current album or artist cover"
msgstr "Màu sắc thay đổi dựa trên bìa album hoặc ảnh nghệ sĩ hiện tại"

msgid "No ads"
msgstr "Không có quảng cáo"

msgid "Initial release."
msgstr "Phát hành lần đầu."

msgid "When connected and there is no album or artist image"
msgstr "Khi đã kết nối nhưng không có ảnh album hoặc nghệ sĩ"

msgid "Colored window when connected"
msgstr "Cửa sổ màu khi được kết nối"

msgid "AI translation (GPT-5.2); reviewed by nobody"
msgstr "Machine translation (Google Translate, edited with Codex); not human-reviewed"

msgid "This release focuses on visuals and localization."
msgstr "Bản phát hành này tập trung vào hình ảnh và bản địa hóa."

msgid "Fine-tuned dark/light mode detection so light colors are no longer mistaken for dark ones."
msgstr "Tinh chỉnh phát hiện chế độ tối/sáng để màu sáng không còn bị nhầm lẫn với màu tối."

msgid "Polished translations and improved how they are applied."
msgstr "Đã trau chuốt bản dịch và cải thiện cách áp dụng."

msgid "Removed gaps between sound bars."
msgstr "Đã bỏ khoảng trống giữa các cột âm thanh."

msgid "Streaming logic now better handles connection issues and stream changes."
msgstr "Logic phát trực tuyến hiện xử lý tốt hơn các sự cố kết nối và thay đổi luồng."

msgid "Clarified the application description."
msgstr "Làm rõ mô tả ứng dụng."

msgid "Translated image captions"
msgstr "Chú thích hình ảnh được dịch"

msgid "Updated screenshots to use a more reasonable window size"
msgstr "Cập nhật ảnh chụp màn hình để sử dụng kích thước cửa sổ hợp lý hơn"

msgid "Updated application icon"
msgstr "Biểu tượng ứng dụng được cập nhật"

msgid "Display the application icon in media controls."
msgstr "Hiển thị biểu tượng ứng dụng trong điều khiển phương tiện."

msgid "Optional Discord activity sharing"
msgstr "Chia sẻ hoạt động Discord tùy chọn"

msgid "Added Discord activity sharing."
msgstr "Đã thêm chia sẻ hoạt động Discord."

msgid "Reconnect to Discord instead of disabling this feature."
msgstr "Tự kết nối lại với Discord thay vì tắt tính năng này."

msgid "Added flags to control pause behavior, autoplay, or disable Discord integration."
msgstr "Đã thêm cờ để kiểm soát hành vi tạm dừng, tự động phát hoặc tắt tích hợp Discord."

msgid "Fixed an issue where paused playback resumed during a network disruption."
msgstr "Đã khắc phục sự cố tiếp tục phát lại bị tạm dừng khi mạng bị gián đoạn."

msgid "Added preferences and keyboard shortcuts."
msgstr "Đã thêm tùy chọn và phím tắt."

msgid "Changed pause, resume, and station switching behavior."
msgstr "Đã thay đổi hành vi tạm dừng, tiếp tục và chuyển đài."

msgid "Added startup options for pause/resume or stop behavior, with play/stop now the default."
msgstr "Đã thêm các tùy chọn khởi động để tạm dừng/tiếp tục hoặc dừng hoạt động, với chế độ phát/dừng hiện là mặc định."

msgid "Check for updates"
msgstr "Kiểm tra các bản cập nhật"

msgid "Cancel update"
msgstr "Hủy cập nhật"

msgid "Couldn't check for updates"
msgstr "Không thể kiểm tra cập nhật"

msgid "Try again later."
msgstr "Hãy thử lại sau."

msgid "Already up to date"
msgstr "Đã cập nhật"

msgid "You have the latest version of Listen Moe."
msgstr "Bạn có phiên bản mới nhất của Listen Moe."

msgid "The release metadata is missing a valid SHA-256 digest."
msgstr "Siêu dữ liệu của bản phát hành thiếu giá trị băm SHA-256 hợp lệ."

msgid "Couldn't download the update"
msgstr "Không thể tải xuống bản cập nhật"

msgid "Update canceled"
msgstr "Đã hủy cập nhật"

msgid "The update was canceled."
msgstr "Bản cập nhật đã bị hủy."

msgid "The update check was canceled."
msgstr "Việc kiểm tra cập nhật đã bị hủy."

msgid "The downloaded installer will not be installed."
msgstr "Trình cài đặt đã tải xuống sẽ không được cài đặt."

msgid "Installing update"
msgstr "Đang cài đặt bản cập nhật"

msgid "Listen Moe will close."
msgstr "Listen Moe sẽ đóng."

msgid "Couldn't install the update"
msgstr "Không thể cài đặt bản cập nhật"

msgid "Checking for updates"
msgstr "Đang kiểm tra cập nhật"

msgid "Downloading update"
msgstr "Đang tải xuống bản cập nhật"

msgid "Update ready"
msgstr "Đã sẵn sàng cập nhật"

msgid "Version"
msgstr "Phiên bản"

msgid "Downloaded"
msgstr "Đã tải xuống"

msgid "Looking for a newer Windows installer on GitHub Releases."
msgstr "Đang tìm trình cài đặt mới hơn cho Windows trên GitHub Releases."

msgid "A newer Windows release is available."
msgstr "Đã có phiên bản mới hơn của ứng dụng dành cho Windows."

msgid "The installer is ready to run."
msgstr "Trình cài đặt đã sẵn sàng để chạy."

msgid "Couldn't start the installer."
msgstr "Không thể khởi động trình cài đặt."

msgid "Removed pause/resume from stable builds."
msgstr "Đã xóa tạm dừng/tiếp tục khỏi các bản dựng ổn định."

msgid "Separate experimental features from stable features."
msgstr "Tách biệt các tính năng thử nghiệm khỏi các tính năng ổn định."

msgid "Volume control added."
msgstr "Đã thêm điều khiển âm lượng."

msgid "Karaoke"
msgstr "Karaoke"

msgid "Show karaoke"
msgstr "Hiện karaoke"

msgid "Finding lyrics…"
msgstr "Đang tìm lời bài hát…"

msgid "Just a moment"
msgstr "Chỉ một lát thôi"

msgid "No synchronized lyrics"
msgstr "Không có lời bài hát đồng bộ"

msgid "This song can still be your tiny concert."
msgstr "Bài hát này vẫn có thể là buổi hòa nhạc nhỏ của bạn."

msgid "Couldn't load lyrics"
msgstr "Không thể tải lời bài hát"

msgid "Try again in a moment."
msgstr "Hãy thử lại sau giây lát."

msgid "Lyrics by LRCLIB"
msgstr "Lời bài hát do LRCLIB cung cấp"

msgid "Added lyrics."
msgstr "Đã thêm lời bài hát."

msgid "Added a song progress bar."
msgstr "Đã thêm thanh tiến trình bài hát."

msgid "Long artist and song names scroll smoothly."
msgstr "Tên nghệ sĩ và bài hát dài cuộn mượt mà."

msgid "Hover over the title to see the full text."
msgstr "Di chuột qua tiêu đề để xem toàn văn."

msgid "Scrolling text and background animations respect Reduce Motion."
msgstr "Văn bản cuộn và hoạt ảnh nền tuân theo cài đặt Giảm chuyển động."

msgid "Translate"
msgstr "Dịch"

msgid "Help translate Listen Moe"
msgstr "Giúp dịch Listen Moe"

msgid "Help improve Listen Moe translations on Weblate."
msgstr "Giúp cải thiện các bản dịch Listen Moe trên Weblate."

msgid "Open Weblate"
msgstr "Mở Weblate"
