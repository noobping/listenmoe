msgstr "Спиране на възпроизвеждането"

msgid "Copy current track"
msgstr "Копиране на текущата песен"

msgid "Stations"
msgstr "Станции"

msgid "Play J-POP"
msgstr "Пусни J-POP"

msgid "Play K-POP"
msgstr "Пусни K-POP"

msgid "Previous station"
msgstr "Предишна станция"

msgid "Next station"
msgstr "Следваща станция"

msgid "Window"
msgstr "Прозорец"

msgid "Open preferences"
msgstr "Отваряне на настройките"

msgid "Show shortcuts"
msgstr "Показване на клавишните комбинации"

msgid "Preferences"
msgstr "Настройки"

msgid "Startup Defaults"
msgstr "Начални настройки"

msgid "Experimental Features"
msgstr "Експериментални функции"

msgid "Default station"
msgstr "Стандартна станция"

msgid "J-POP"
msgstr "J-POP"

msgid "K-POP"
msgstr "K-POP"

msgid "Autoplay"
msgstr "Автоматично възпроизвеждане"

msgid "Start playing automatically on launch"
msgstr "Автоматично пускане при стартиране"

msgid "Enable pause and resume"
msgstr "Включване на пауза и продължаване"

msgid "Use pause and resume for the main playback button"
msgstr "Използване на пауза и продължаване за главния бутон за възпроизвеждане"

msgid "Discord Rich Presence"
msgstr "Discord Rich Presence"

msgid "Enable Discord Rich Presence at runtime"
msgstr "Включване на Discord Rich Presence по време на работа"

msgid "It is time to ditch other radios. Stream and metadata provided by LISTEN.moe."
msgstr "Време е да се откажем от другите радиостанции. Поток и метаданни, предоставени от LISTEN.moe."

msgid "J-POP and K-POP radio"
msgstr "J-POP и K-POP радио"

msgid "Listen to J-POP and K-POP"
msgstr "Слушайте J-POP и K-POP"

msgid "Pause and resume the live stream"
msgstr "Поставете на пауза и възобновете потока на живо"

msgid "Animated sound bars that react to the music"
msgstr "Анимирани звукови ленти, които реагират на музиката"

msgid "Dynamic colors based on the current album or artist cover"
msgstr "Динамични цветове според обложката на текущия албум или изображението на изпълнителя"

msgid "No ads"
msgstr "Без реклами"

msgid "Initial release."
msgstr "Първоначално издание."

msgid "When connected and there is no album or artist image"
msgstr "Когато е свързан и няма изображение на албум или изпълнител"

msgid "Colored window when connected"
msgstr "Цветен прозорец, когато е свързан"

msgid "AI translation (GPT-5.2); reviewed by nobody"
msgstr "Machine translation (Google Translate, edited with Codex); not human-reviewed"

msgid "This release focuses on visuals and localization."
msgstr "Тази версия се фокусира върху визуални елементи и локализация."

msgid "Fine-tuned dark/light mode detection so light colors are no longer mistaken for dark ones."
msgstr "Фино настроено разпознаване на тъмен/светъл режим, така че светлите цветове вече да не се бъркат с тъмни."

msgid "Polished translations and improved how they are applied."
msgstr "Подобрени преводи и начин на прилагането им."

msgid "Removed gaps between sound bars."
msgstr "Премахнати празнини между звуковите ленти."

msgid "Streaming logic now better handles connection issues and stream changes."
msgstr "Логиката за поточно предаване вече се справя по-добре с проблеми с връзката и промени в потока."

msgid "Clarified the application description."
msgstr "Изяснено е описанието на приложението."

msgid "Translated image captions"
msgstr "Преведени надписи на изображения"

msgid "Updated screenshots to use a more reasonable window size"
msgstr "Актуализирани екранни снимки за използване на по-разумен размер на прозореца"

msgid "Updated application icon"
msgstr "Актуализирана икона на приложението"

msgid "Display the application icon in media controls."
msgstr "Показване на иконата на приложението в медийните контроли."

msgid "Optional Discord activity sharing"
msgstr "Опционално споделяне на дейност в Discord"

msgid "Added Discord activity sharing."
msgstr "Добавено споделяне на дейност в Discord."

msgid "Reconnect to Discord instead of disabling this feature."
msgstr "Повторно свързване с Discord вместо изключване на тази функция."

msgid "Added flags to control pause behavior, autoplay, or disable Discord integration."
msgstr "Добавени флагове за контролиране на поведението на пауза, автоматично пускане или деактивиране на интеграцията на Discord."

msgid "Fixed an issue where paused playback resumed during a network disruption."
msgstr "Коригиран проблем, при който възпроизвеждането на пауза се възобнови по време на прекъсване на мрежата."

msgid "Added preferences and keyboard shortcuts."
msgstr "Добавени предпочитания и клавишни комбинации."

msgid "Changed pause, resume, and station switching behavior."
msgstr "Променено поведение на пауза, възобновяване и превключване на станции."

msgid "Added startup options for pause/resume or stop behavior, with play/stop now the default."
msgstr "Добавени са опции за стартиране за поведение на пауза/възобновяване или спиране, като възпроизвеждане/стоп вече е по подразбиране."

msgid "Check for updates"
msgstr "Проверка за актуализации"

msgid "Cancel update"
msgstr "Отказ от актуализация"

msgid "Couldn't check for updates"
msgstr "Неуспешна проверка за актуализации"

msgid "Try again later."
msgstr "Опитайте отново по-късно."

msgid "Already up to date"
msgstr "Вече е актуален"

msgid "You have the latest version of Listen Moe."
msgstr "Имате най-новата версия на Listen Moe."

msgid "The release metadata is missing a valid SHA-256 digest."
msgstr "В метаданните на изданието липсва валидна контролна сума SHA-256."

msgid "Couldn't download the update"
msgstr "Актуализацията не можа да бъде изтеглена"

msgid "Update canceled"
msgstr "Актуализацията е отменена"

msgid "The update was canceled."
msgstr "Актуализацията беше отменена."

msgid "The update check was canceled."
msgstr "Проверката за актуализация беше отменена."

msgid "The downloaded installer will not be installed."
msgstr "Изтегленият инсталатор няма да бъде инсталиран."

msgid "Installing update"
msgstr "Инсталиране на актуализация"

msgid "Listen Moe will close."
msgstr "Listen Moe ще се затвори."

msgid "Couldn't install the update"
msgstr "Актуализацията не можа да се инсталира"

msgid "Checking for updates"
msgstr "Проверка за актуализации"

msgid "Downloading update"
msgstr "Изтегля се актуализация"

msgid "Update ready"
msgstr "Актуализацията е готова"

msgid "Version"
msgstr "Версия"

msgid "Downloaded"
msgstr "Изтеглено"

msgid "Looking for a newer Windows installer on GitHub Releases."
msgstr "Търси се по-нова инсталационна програма за Windows в GitHub Releases."

msgid "A newer Windows release is available."
msgstr "Налично е по-ново издание на приложението за Windows."

msgid "The installer is ready to run."
msgstr "Инсталаторът е готов за стартиране."

msgid "Couldn't start the installer."
msgstr "Инсталационната програма не може да стартира."

msgid "Removed pause/resume from stable builds."
msgstr "Премахнато пауза/възобновяване от стабилни компилации."

msgid "Separate experimental features from stable features."
msgstr "Разделяне на експерименталните функции от стабилните."

msgid "Volume control added."
msgstr "Добавен контрол на силата на звука."

msgid "Karaoke"
msgstr "Караоке"

msgid "Show karaoke"
msgstr "Покажи караоке"

msgid "Finding lyrics…"
msgstr "Търсене на текст на песента…"

msgid "Just a moment"
msgstr "Само момент"

msgid "No synchronized lyrics"
msgstr "Няма синхронизирани текстове"

msgid "This song can still be your tiny concert."
msgstr "Тази песен все още може да бъде вашият малък концерт."

msgid "Couldn't load lyrics"
msgstr "Текстът не можа да се зареди"

msgid "Try again in a moment."
msgstr "Опитайте отново след малко."

msgid "Lyrics by LRCLIB"
msgstr "Текстове от LRCLIB"

msgid "Added lyrics."
msgstr "Добавени текстове на песни."

msgid "Added a song progress bar."
msgstr "Добавена е лента за прогрес на песента."

msgid "Long artist and song names scroll smoothly."
msgstr "Дългите имена на изпълнители и песни се превъртат плавно."

msgid "Hover over the title to see the full text."
msgstr "Задръжте курсора на мишката върху заглавието, за да видите пълния текст."

msgid "Scrolling text and background animations respect Reduce Motion."
msgstr "Превъртането на текста и фоновите анимации спазват настройката за намалено движение."
