msgstr "Előző állomás"

msgid "Next station"
msgstr "Következő állomás"

msgid "Window"
msgstr "Ablak"

msgid "Open preferences"
msgstr "Beállítások megnyitása"

msgid "Show shortcuts"
msgstr "Gyorsbillentyűk megjelenítése"

msgid "Preferences"
msgstr "Beállítások"

msgid "Startup Defaults"
msgstr "Indítási alapbeállítások"

msgid "Experimental Features"
msgstr "Kísérleti funkciók"

msgid "Default station"
msgstr "Alapértelmezett állomás"

msgid "J-POP"
msgstr "J-POP"

msgid "K-POP"
msgstr "K-POP"

msgid "Autoplay"
msgstr "Automatikus lejátszás"

msgid "Start playing automatically on launch"
msgstr "Lejátszás automatikus indítása az alkalmazás indításakor"

msgid "Enable pause and resume"
msgstr "Szüneteltetés és folytatás engedélyezése"

msgid "Use pause and resume for the main playback button"
msgstr "Szüneteltetés és folytatás használata a fő lejátszógombnál"

msgid "Discord Rich Presence"
msgstr "Discord Rich Presence"

msgid "Enable Discord Rich Presence at runtime"
msgstr "Discord Rich Presence engedélyezése futás közben"

msgid "It is time to ditch other radios. Stream and metadata provided by LISTEN.moe."
msgstr "Ideje elhagyni a többi rádiót. Az adatfolyamot és a metaadatokat a LISTEN.moe biztosítja."

msgid "J-POP and K-POP radio"
msgstr "J-POP és K-POP rádió"

msgid "Listen to J-POP and K-POP"
msgstr "Hallgass J-POP-ot és K-POP-ot"

msgid "Pause and resume the live stream"
msgstr "Az élő közvetítés szüneteltetése és folytatása"

msgid "Animated sound bars that react to the music"
msgstr "A zenére reagáló animált hangoszlopok"

msgid "Dynamic colors based on the current album or artist cover"
msgstr "Dinamikus színek az aktuális albumborító vagy előadói kép alapján"

msgid "No ads"
msgstr "Nincsenek hirdetések"

msgid "Initial release."
msgstr "Kezdeti kiadás."

msgid "When connected and there is no album or artist image"
msgstr "Csatlakozáskor, ha nincs albumborító vagy előadói kép"

msgid "Colored window when connected"
msgstr "Csatlakozáskor színes ablak"

msgid "AI translation (GPT-5.2); reviewed by nobody"
msgstr "Machine translation (Google Translate, edited with Codex); not human-reviewed"

msgid "This release focuses on visuals and localization."
msgstr "Ez a kiadás a látványra és a lokalizációra összpontosít."

msgid "Fine-tuned dark/light mode detection so light colors are no longer mistaken for dark ones."
msgstr "Finomhangolt sötét/világos mód érzékelés, így a világos színeket többé nem tévesztik össze a sötétekkel."

msgid "Polished translations and improved how they are applied."
msgstr "Csiszolt fordítások és továbbfejlesztett alkalmazásuk."

msgid "Removed gaps between sound bars."
msgstr "Eltávolítottuk a hangoszlopok közötti réseket."

msgid "Streaming logic now better handles connection issues and stream changes."
msgstr "A streamelési logika jobban kezeli a csatlakozási problémákat és az adatfolyam-változásokat."

msgid "Clarified the application description."
msgstr "Pontosítottuk az alkalmazás leírását."

msgid "Translated image captions"
msgstr "Lefordított képaláírások"

msgid "Updated screenshots to use a more reasonable window size"
msgstr "Frissítettük a képernyőképeket, hogy ésszerűbb ablakméretet használjunk"

msgid "Updated application icon"
msgstr "Frissített alkalmazás ikon"

msgid "Display the application icon in media controls."
msgstr "Jelenítse meg az alkalmazás ikonját a médiavezérlőkben."

msgid "Optional Discord activity sharing"
msgstr "Opcionális Discord tevékenységmegosztás"

msgid "Added Discord activity sharing."
msgstr "Discord tevékenységmegosztás hozzáadva."

msgid "Reconnect to Discord instead of disabling this feature."
msgstr "Újracsatlakozás a Discordhoz a funkció letiltása helyett."

msgid "Added flags to control pause behavior, autoplay, or disable Discord integration."
msgstr "Hozzáadott jelzők a szüneteltetés, az automatikus lejátszás vezérléséhez vagy a Discord integráció letiltásához."

msgid "Fixed an issue where paused playback resumed during a network disruption."
msgstr "Kijavítottuk azt a hibát, amely miatt a szüneteltetett lejátszás folytatódott a hálózati zavarok miatt."

msgid "Added preferences and keyboard shortcuts."
msgstr "Hozzáadott beállítások és billentyűparancsok."

msgid "Changed pause, resume, and station switching behavior."
msgstr "Megváltozott a szüneteltetés, folytatás és az állomásváltási viselkedés."

msgid "Added startup options for pause/resume or stop behavior, with play/stop now the default."
msgstr "Hozzáadott indítási beállítások a szüneteltetés/folytatás vagy leállításhoz, a lejátszás/leállítás most az alapértelmezett."

msgid "Check for updates"
msgstr "Frissítések keresése"

msgid "Cancel update"
msgstr "A frissítés megszakítása"

msgid "Couldn't check for updates"
msgstr "Nem sikerült ellenőrizni a frissítéseket"

msgid "Try again later."
msgstr "Próbálja újra később."

msgid "Already up to date"
msgstr "Már naprakész"

msgid "You have the latest version of Listen Moe."
msgstr "A Listen Moe legújabb verziója van."

msgid "The release metadata is missing a valid SHA-256 digest."
msgstr "A kiadás metaadataiból hiányzik egy érvényes SHA-256 kivonat."

msgid "Couldn't download the update"
msgstr "Nem sikerült letölteni a frissítést"

msgid "Update canceled"
msgstr "Frissítés megszakítva"

msgid "The update was canceled."
msgstr "A frissítést törölték."

msgid "The update check was canceled."
msgstr "A frissítés ellenőrzése megszakadt."

msgid "The downloaded installer will not be installed."
msgstr "A letöltött telepítő nem lesz telepítve."

msgid "Installing update"
msgstr "Frissítés telepítése"

msgid "Listen Moe will close."
msgstr "A Listen Moe bezárul."

msgid "Couldn't install the update"
msgstr "Nem sikerült telepíteni a frissítést"

msgid "Checking for updates"
msgstr "Frissítések keresése"

msgid "Downloading update"
msgstr "Frissítés letöltése"

msgid "Update ready"
msgstr "Frissítés kész"

msgid "Version"
msgstr "Verzió"

msgid "Downloaded"
msgstr "Letöltve"

msgid "Looking for a newer Windows installer on GitHub Releases."
msgstr "Újabb Windows-telepítő keresése a GitHub Releases oldalon."

msgid "A newer Windows release is available."
msgstr "Újabb Windows-verzió érhető el az alkalmazásból."

msgid "The installer is ready to run."
msgstr "A telepítő készen áll a futtatásra."

msgid "Couldn't start the installer."
msgstr "Nem sikerült elindítani a telepítőt."

msgid "Removed pause/resume from stable builds."
msgstr "A szünet/folytatás eltávolítva a stabil buildekből."

msgid "Separate experimental features from stable features."
msgstr "A kísérleti funkciók elkülönítése a stabil funkcióktól."

msgid "Volume control added."
msgstr "Hangerőszabályzó hozzáadva."

msgid "Karaoke"
msgstr "Karaoke"

msgid "Show karaoke"
msgstr "Karaoke megjelenítése"

msgid "Finding lyrics…"
msgstr "Dalszöveg keresése…"

msgid "Just a moment"
msgstr "Csak egy pillanat"

msgid "No synchronized lyrics"
msgstr "Nincs szinkronizált dalszöveg"

msgid "This song can still be your tiny concert."
msgstr "Ez a dal még mindig a te kis koncerted lehet."

msgid "Couldn't load lyrics"
msgstr "Nem sikerült betölteni a dalszöveget"

msgid "Try again in a moment."
msgstr "Próbálja újra egy pillanat múlva."

msgid "Lyrics by LRCLIB"
msgstr "Dalszövegek az LRCLIB-től"

msgid "Added lyrics."
msgstr "Hozzáadott dalszöveg."

msgid "Added a song progress bar."
msgstr "Hozzáadott egy dal folyamatjelző sávot."

msgid "Long artist and song names scroll smoothly."
msgstr "A hosszú előadónevek és dalcímek simán görgetődnek."

msgid "Hover over the title to see the full text."
msgstr "A teljes szöveg megtekintéséhez vigye az egérmutatót a cím fölé."

msgid "Scrolling text and background animations respect Reduce Motion."
msgstr "A görgető szöveg és a háttéranimációk tiszteletben tartják a Mozgáscsökkentés funkciót."

msgid "Translate"
msgstr "Fordítás"

msgid "Help translate Listen Moe"
msgstr "Segítsen a Listen Moe fordításában"

msgid "Help improve Listen Moe translations on Weblate."
msgstr "Segítsen javítani a Listen Moe fordításait a Weblate-en."

msgid "Open Weblate"
msgstr "Weblate megnyitása"
