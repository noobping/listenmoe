msgstr "Fonctionnalités expérimentales"

msgid "Default station"
msgstr "Station par défaut"

msgid "J-POP"
msgstr "J-POP"

msgid "K-POP"
msgstr "K-POP"

msgid "Autoplay"
msgstr "Lecture automatique"

msgid "Start playing automatically on launch"
msgstr "Démarrer la lecture au lancement"

msgid "Enable pause and resume"
msgstr "Activer la pause et la reprise"

msgid "Use pause and resume for the main playback button"
msgstr "Utiliser la pause et la reprise pour le bouton principal de lecture"

msgid "Discord Rich Presence"
msgstr "Discord Rich Presence"

msgid "Enable Discord Rich Presence at runtime"
msgstr "Activer Discord Rich Presence pendant l’exécution"

msgid "It is time to ditch other radios. Stream and metadata provided by LISTEN.moe."
msgstr "Il est temps de changer de radio. Flux et métadonnées fournis par LISTEN.moe."

msgid "J-POP and K-POP radio"
msgstr "Radio J-POP et K-POP"

msgid "Listen to J-POP and K-POP"
msgstr "Écoutez de la J-POP et de la K-POP"

msgid "Pause and resume the live stream"
msgstr "Mettez le flux en direct en pause et reprenez la lecture"

msgid "Animated sound bars that react to the music"
msgstr "Barres sonores animées qui réagissent à la musique"

msgid "Dynamic colors based on the current album or artist cover"
msgstr "Couleurs dynamiques selon la pochette de l’album ou l’image de l’artiste"

msgid "No ads"
msgstr "Sans publicité"

msgid "Initial release."
msgstr "Première version."

msgid "When connected and there is no album or artist image"
msgstr "Lorsque la connexion est établie et qu’aucune image d’album ou d’artiste n’est disponible"

msgid "Colored window when connected"
msgstr "Fenêtre colorée lorsque la connexion est établie"

msgid "AI translation (GPT-5.2); reviewed by nobody"
msgstr "AI translation (Codex); not human-reviewed"

msgid "This release focuses on visuals and localization."
msgstr "Cette version se concentre sur l’apparence et la traduction."

msgid "Fine-tuned dark/light mode detection so light colors are no longer mistaken for dark ones."
msgstr "Détection des modes sombre et clair affinée pour ne plus confondre les couleurs claires et sombres."

msgid "Polished translations and improved how they are applied."
msgstr "Traductions soignées et meilleure prise en compte."

msgid "Removed gaps between sound bars."
msgstr "Suppression des espaces entre les barres sonores."

msgid "Streaming logic now better handles connection issues and stream changes."
msgstr "La diffusion gère mieux les problèmes de connexion et les changements de flux."

msgid "Clarified the application description."
msgstr "Description de l’application clarifiée."

msgid "Translated image captions"
msgstr "Légendes des images traduites"

msgid "Updated screenshots to use a more reasonable window size"
msgstr "Captures d’écran mises à jour avec une taille de fenêtre plus adaptée"

msgid "Updated application icon"
msgstr "Icône de l’application mise à jour"

msgid "Display the application icon in media controls."
msgstr "Affichage de l’icône de l’application dans les commandes multimédias."

msgid "Optional Discord activity sharing"
msgstr "Partage facultatif de l’activité sur Discord"

msgid "Added Discord activity sharing."
msgstr "Ajout du partage de l’activité sur Discord."

msgid "Reconnect to Discord instead of disabling this feature."
msgstr "Reconnexion à Discord au lieu de désactiver cette fonctionnalité."

msgid "Added flags to control pause behavior, autoplay, or disable Discord integration."
msgstr "Ajout d’options pour contrôler la pause, la lecture automatique ou désactiver l’intégration Discord."

msgid "Fixed an issue where paused playback resumed during a network disruption."
msgstr "Correction d’un problème qui relançait la lecture en pause lors d’une interruption réseau."

msgid "Added preferences and keyboard shortcuts."
msgstr "Ajout des préférences et des raccourcis clavier."

msgid "Changed pause, resume, and station switching behavior."
msgstr "Modification du comportement de la pause, de la reprise et du changement de station."

msgid "Added startup options for pause/resume or stop behavior, with play/stop now the default."
msgstr "Ajout d’options de démarrage pour la pause/reprise ou l’arrêt, avec lecture/arrêt par défaut."

msgid "Check for updates"
msgstr "Rechercher des mises à jour"

msgid "Cancel update"
msgstr "Annuler la mise à jour"

msgid "Couldn't check for updates"
msgstr "Impossible de rechercher des mises à jour"

msgid "Try again later."
msgstr "Réessayez plus tard."

msgid "Already up to date"
msgstr "Déjà à jour"

msgid "You have the latest version of Listen Moe."
msgstr "Vous disposez de la dernière version de Listen Moe."

msgid "The release metadata is missing a valid SHA-256 digest."
msgstr "Les métadonnées de la version ne contiennent pas d’empreinte SHA-256 valide."

msgid "Couldn't download the update"
msgstr "Impossible de télécharger la mise à jour"

msgid "Update canceled"
msgstr "Mise à jour annulée"

msgid "The update was canceled."
msgstr "La mise à jour a été annulée."

msgid "The update check was canceled."
msgstr "La recherche de mises à jour a été annulée."

msgid "The downloaded installer will not be installed."
msgstr "Le programme d’installation téléchargé ne sera pas installé."

msgid "Installing update"
msgstr "Installation de la mise à jour"

msgid "Listen Moe will close."
msgstr "Listen Moe va se fermer."

msgid "Couldn't install the update"
msgstr "Impossible d’installer la mise à jour"

msgid "Checking for updates"
msgstr "Recherche de mises à jour"

msgid "Downloading update"
msgstr "Téléchargement de la mise à jour"

msgid "Update ready"
msgstr "Mise à jour prête"

msgid "Version"
msgstr "Version"

msgid "Downloaded"
msgstr "Téléchargé"

msgid "Looking for a newer Windows installer on GitHub Releases."
msgstr "Recherche d’un programme d’installation Windows plus récent sur GitHub Releases."

msgid "A newer Windows release is available."
msgstr "Une nouvelle version pour Windows est disponible."

msgid "The installer is ready to run."
msgstr "Le programme d’installation est prêt à être exécuté."

msgid "Couldn't start the installer."
msgstr "Impossible de lancer le programme d’installation."

msgid "Removed pause/resume from stable builds."
msgstr "Suppression de la pause/reprise dans les versions stables."

msgid "Separate experimental features from stable features."
msgstr "Séparation des fonctionnalités expérimentales et stables."

msgid "Volume control added."
msgstr "Ajout du réglage du volume."

msgid "Karaoke"
msgstr "Karaoké"

msgid "Show karaoke"
msgstr "Afficher le karaoké"

msgid "Finding lyrics…"
msgstr "Recherche des paroles…"

msgid "Just a moment"
msgstr "Un instant"

msgid "No synchronized lyrics"
msgstr "Aucune parole synchronisée"

msgid "This song can still be your tiny concert."
msgstr "Cette chanson peut quand même être votre petit concert."

msgid "Couldn't load lyrics"
msgstr "Impossible de charger les paroles"

msgid "Try again in a moment."
msgstr "Réessayez dans un instant."

msgid "Lyrics by LRCLIB"
msgstr "Paroles fournies par LRCLIB"

msgid "Added lyrics."
msgstr "Ajout des paroles."

msgid "Added a song progress bar."
msgstr "Ajout d’une barre de progression du morceau."

msgid "Long artist and song names scroll smoothly."
msgstr "Les longs noms d’artistes et de morceaux défilent de manière fluide."

msgid "Hover over the title to see the full text."
msgstr "Survolez le titre pour voir le texte complet."

msgid "Scrolling text and background animations respect Reduce Motion."
msgstr "Le défilement du texte et les animations d’arrière-plan respectent l’option de réduction des animations."
