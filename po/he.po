msgstr "ניגון או השהיה"

msgid "Stop playback"
msgstr "עצירת הניגון"

msgid "Copy current track"
msgstr "העתקת הרצועה הנוכחית"

msgid "Stations"
msgstr "תחנות"

msgid "Play J-POP"
msgstr "ניגון J-POP"

msgid "Play K-POP"
msgstr "ניגון K-POP"

msgid "Previous station"
msgstr "התחנה הקודמת"

msgid "Next station"
msgstr "התחנה הבאה"

msgid "Window"
msgstr "חלון"

msgid "Open preferences"
msgstr "פתיחת ההעדפות"

msgid "Show shortcuts"
msgstr "הצגת קיצורים"

msgid "Preferences"
msgstr "העדפות"

msgid "Startup Defaults"
msgstr "ברירות מחדל בהפעלה"

msgid "Experimental Features"
msgstr "תכונות ניסיוניות"

msgid "Default station"
msgstr "תחנת ברירת מחדל"

msgid "J-POP"
msgstr "J-POP"

msgid "K-POP"
msgstr "K-POP"

msgid "Autoplay"
msgstr "ניגון אוטומטי"

msgid "Start playing automatically on launch"
msgstr "התחלת ניגון אוטומטית עם פתיחת היישום"

msgid "Enable pause and resume"
msgstr "הפעלת השהיה והמשך"

msgid "Use pause and resume for the main playback button"
msgstr "שימוש בהשהיה והמשך בכפתור הניגון הראשי"

msgid "Discord Rich Presence"
msgstr "Discord Rich Presence"

msgid "Enable Discord Rich Presence at runtime"
msgstr "הפעלת Discord Rich Presence בזמן שהיישום פועל"

msgid "It is time to ditch other radios. Stream and metadata provided by LISTEN.moe."
msgstr "הגיע הזמן לוותר על מכשירי רדיו אחרים. זרם ומטא נתונים מסופקים על ידי LISTEN.moe."

msgid "J-POP and K-POP radio"
msgstr "רדיו J-POP ו-K-POP"

msgid "Listen to J-POP and K-POP"
msgstr "האזינו ל-J-POP ו-K-POP"

msgid "Pause and resume the live stream"
msgstr "השהה והמשך את השידור החי"

msgid "Animated sound bars that react to the music"
msgstr "עמודות שמע מונפשות המגיבות למוזיקה"

msgid "Dynamic colors based on the current album or artist cover"
msgstr "צבעים דינמיים המבוססים על עטיפת האלבום או תמונת האמן הנוכחי"

msgid "No ads"
msgstr "אין פרסומות"

msgid "Initial release."
msgstr "גרסה ראשונה."

msgid "When connected and there is no album or artist image"
msgstr "כאשר יש חיבור ואין תמונת אלבום או אמן"

msgid "Colored window when connected"
msgstr "חלון צבעוני בעת חיבור"

msgid "AI translation (GPT-5.2); reviewed by nobody"
msgstr "Machine translation (Google Translate, edited with Codex); not human-reviewed"

msgid "This release focuses on visuals and localization."
msgstr "מהדורה זו מתמקדת בוויזואליה ולוקליזציה."

msgid "Fine-tuned dark/light mode detection so light colors are no longer mistaken for dark ones."
msgstr "זיהוי מצב כהה/בהיר מכוון עדין כך שצבעים בהירים כבר לא יתחשבו בטעות לכהים."

msgid "Polished translations and improved how they are applied."
msgstr "ליטוש תרגומים ושיפור אופן היישום שלהם."

msgid "Removed gaps between sound bars."
msgstr "הוסרו הרווחים בין עמודות השמע."

msgid "Streaming logic now better handles connection issues and stream changes."
msgstr "לוגיקה של סטרימינג מטפלת כעת בצורה טובה יותר בבעיות חיבור ושינויי זרימה."

msgid "Clarified the application description."
msgstr "תיאור היישום הובהר."

msgid "Translated image captions"
msgstr "כתוביות תמונה מתורגמות"

msgid "Updated screenshots to use a more reasonable window size"
msgstr "צילומי מסך מעודכנים לשימוש בגודל חלון סביר יותר"

msgid "Updated application icon"
msgstr "סמל אפליקציה מעודכן"

msgid "Display the application icon in media controls."
msgstr "הצג את סמל היישום בפקדי המדיה."

msgid "Optional Discord activity sharing"
msgstr "שיתוף פעילות Discord אופציונלי"

msgid "Added Discord activity sharing."
msgstr "נוסף שיתוף פעילות ב־Discord."

msgid "Reconnect to Discord instead of disabling this feature."
msgstr "חיבור מחדש ל־Discord במקום השבתת התכונה."

msgid "Added flags to control pause behavior, autoplay, or disable Discord integration."
msgstr "נוספו דגלים כדי לשלוט בהתנהגות השהייה, להפעלה אוטומטית או להשבית שילוב של Discord."

msgid "Fixed an issue where paused playback resumed during a network disruption."
msgstr "תוקנה בעיה שבה ההפעלה המושהית התחדשה במהלך הפרעה ברשת."

msgid "Added preferences and keyboard shortcuts."
msgstr "נוספו העדפות וקיצורי מקשים."

msgid "Changed pause, resume, and station switching behavior."
msgstr "שונה אופן הפעולה של השהיה, המשך ומעבר בין תחנות."

msgid "Added startup options for pause/resume or stop behavior, with play/stop now the default."
msgstr "נוספו אפשרויות הפעלה להתנהגות השהייה/המשך או עצירה, עם הפעלה/עצירה כעת כברירת המחדל."

msgid "Check for updates"
msgstr "בדיקת עדכונים"

msgid "Cancel update"
msgstr "ביטול העדכון"

msgid "Couldn't check for updates"
msgstr "לא ניתן היה לחפש עדכונים"

msgid "Try again later."
msgstr "נסה שוב מאוחר יותר."

msgid "Already up to date"
msgstr "כבר מעודכן"

msgid "You have the latest version of Listen Moe."
msgstr "יש לך את הגרסה העדכנית ביותר של Listen Moe."

msgid "The release metadata is missing a valid SHA-256 digest."
msgstr "במטא-נתונים של הגרסה חסר תקציר SHA-256 חוקי."

msgid "Couldn't download the update"
msgstr "לא ניתן היה להוריד את העדכון"

msgid "Update canceled"
msgstr "העדכון בוטל"

msgid "The update was canceled."
msgstr "העדכון בוטל."

msgid "The update check was canceled."
msgstr "בדיקת העדכון בוטלה."

msgid "The downloaded installer will not be installed."
msgstr "תוכנית ההתקנה שהורדת לא תותקן."

msgid "Installing update"
msgstr "מתקין עדכון"

msgid "Listen Moe will close."
msgstr "Listen Moe ייסגר."

msgid "Couldn't install the update"
msgstr "לא ניתן היה להתקין את העדכון"

msgid "Checking for updates"
msgstr "מחפש עדכונים"

msgid "Downloading update"
msgstr "מוריד עדכון"

msgid "Update ready"
msgstr "עדכון מוכן"

msgid "Version"
msgstr "גרסה"

msgid "Downloaded"
msgstr "הורד"

msgid "Looking for a newer Windows installer on GitHub Releases."
msgstr "חיפוש תוכנית התקנה חדשה יותר ל־Windows ב־GitHub Releases."

msgid "A newer Windows release is available."
msgstr "זמינה גרסה חדשה יותר של היישום ל־Windows."

msgid "The installer is ready to run."
msgstr "תוכנית ההתקנה מוכנה להפעלה."

msgid "Couldn't start the installer."
msgstr "לא ניתן היה להפעיל את המתקין."

msgid "Removed pause/resume from stable builds."
msgstr "הוסרה האפשרות להשהיה והמשך מהגרסאות היציבות."

msgid "Separate experimental features from stable features."
msgstr "הפרדת תכונות ניסיוניות מתכונות יציבות."

msgid "Volume control added."
msgstr "נוספה בקרת עוצמת הקול."

msgid "Karaoke"
msgstr "קריוקי"

msgid "Show karaoke"
msgstr "הצג קריוקי"

msgid "Finding lyrics…"
msgstr "מחפש מילים..."

msgid "Just a moment"
msgstr "רק רגע"

msgid "No synchronized lyrics"
msgstr "אין מילים מסונכרנות"

msgid "This song can still be your tiny concert."
msgstr "השיר הזה עדיין יכול להיות הקונצרט הקטן שלך."

msgid "Couldn't load lyrics"
msgstr "לא ניתן היה לטעון את המילים"

msgid "Try again in a moment."
msgstr "נסה שוב בעוד רגע."

msgid "Lyrics by LRCLIB"
msgstr "מילות השירים מסופקות על ידי LRCLIB"

msgid "Added lyrics."
msgstr "נוספו מילים."

msgid "Added a song progress bar."
msgstr "נוסף סרגל התקדמות השיר."

msgid "Long artist and song names scroll smoothly."
msgstr "שמות אמן ושירים ארוכים גוללים בצורה חלקה."

msgid "Hover over the title to see the full text."
msgstr "העבר את העכבר מעל הכותרת כדי לראות את הטקסט המלא."

msgid "Scrolling text and background animations respect Reduce Motion."
msgstr "גלילת טקסט והנפשות רקע פועלות בהתאם להגדרת הפחתת התנועה."

msgid "Translate"
msgstr "תרגום"

msgid "Help translate Listen Moe"
msgstr "סיוע בתרגום Listen Moe"

msgid "Help improve Listen Moe translations on Weblate."
msgstr "עזרו לשפר את התרגומים של Listen Moe ב־Weblate."

msgid "Open Weblate"
msgstr "פתיחת Weblate"
